# Generate a unique value with Django's get_random_secret_key() utility.
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-with-a-generated-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Render / production database (DATABASE_URL). On Render this is provided
# automatically when you add a managed PostgreSQL database to the service.
# Local development falls back to SQLite if DATABASE_URL is unset.
DATABASE_URL=postgres://user:password@host:5432/dbname
